#define DEFAULT 0
#define NUM     1
#define FNC     2
#define MOUSE   3
#define BLUE    4

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>


&lt {
    quick-tap-ms = <250>;
};

// &sk {
//     release-after-ms = <5000>;
//     quick-release;
//     /delete-property/ ignore-modifiers;
// };

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <5000>;
            quick-release;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";

        default_bootloader_r {
            bindings = <&bootloader>;
            key-positions = <10 11>;
        };

        default_bootloader_l {
            bindings = <&bootloader>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |   TAB   |    Q    |    W    |    E    |    R    |    T     |                              |    Y    |    U    |    I    |    O    |    P    |   BLUE  |
// |   ESC   |    A    |    S    |    D    |    F    |    G     |                              |    H    |    J    |    K    |    L    |    ;    |    '    |
// |  SHIFT  |   CTRL  |    Z    |    X    |    C    |    V     |                              |    B    |    N    |    M    |    ,    |    .    |    /    |  
//                     |   GUI   |   ALT   |   BSPC  |   DEL    | RETURN  |            |  TAB  |  SPACE  |                   |   FNC   |
            bindings = <
    &kp TAB      &kp Q     &kp W    &kp E     &kp R     &kp T                                      &kp Y     &kp U     &kp I     &kp O     &kp P     &mo BLUE
    &lt BLUE ESC &kp A     &kp S    &kp D     &kp F     &kp G                                      &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
    &sk LSHIFT   &sk LCTRL &kp Z    &kp X     &kp C     &kp V                                      &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
                           &sk LGUI &sk LALT  &kp BSPC  &lt NUM DEL &kp RET               &kp RET  &kp SPACE                     &mo FNC
            >;
        };

        number_layer {
            label = "NUM";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |   TAB   |    `    |   HOME  |    UP   |   END   |   PGUP  |                              |    |    |    7    |    8    |    9    |    *    |    /    |
// |   ESC   |    ^    |   LEFT  |   DOWN  |  RIGHT  |   PGDN  |                              |    &    |    4    |    5    |    6    |    +    |    -    |
// |  SHIFT  |   CTRL  |   (     |     )   |    [    |     ]   |                              |    !    |    1    |    2    |    3    |    =    |    %    |  
//                     |   GUI   |   ALT   |   BSPC  |   DEL   | RETURN  |            | SPACE |    0    |                   |    .    |
            bindings = <
    &trans    &kp GRAVE  &kp HOME  &kp UP    &kp END   &kp PG_UP                               &kp PIPE  &kp KP_N7 &kp KP_N8 &kp KP_N9  &kp KP_MULTIPLY &kp KP_SLASH
    &trans    &kp CARET  &kp LEFT  &kp DOWN  &kp RIGHT &kp PG_DN                               &kp AMPS  &kp KP_N4 &kp KP_N5 &kp KP_N6  &kp KP_PLUS     &kp KP_MINUS
    &trans    &trans     &kp LPAR  &kp RPAR  &kp LBKT  &kp RBKT                                &kp EXCL  &kp KP_N1 &kp KP_N2 &kp KP_N3  &kp KP_EQUAL    &kp PRCNT
                         &trans    &trans    &trans    &trans     &trans             &kp SPACE &kp KP_N0                     &kp KP_DOT 
            >;

        };

        function_layer {
            label = "FNC";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  NLCK   |   VOLU  |   F1    |   F2    |   F3    |   F4    |                              |   F13   |   F14   |   F15   |   F16   |         |         |
// |  SLCK   |   MUTE  |   F5    |   F6    |   F7    |   F8    |                              |   F17   |   F18   |   F19   |   F20   |         |         |
// |  CAPS   |   VOLD  |   F9    |   F10   |   F11   |   F12   |                              |   F21   |   F22   |   F23   |   F24   |         |         |  
//                     |         |         |   PREV  |   PP    | NEXT  |              | BRIUP |  BRIDN  |                   |         |
            bindings = <
    &kp KP_NLCK &kp VOLU &kp F1    &kp F2    &kp F3    &kp F4                                  &kp F13   &kp F14   &kp F15   &kp F16   &none     &none
    &kp SLCK  &kp K_MUTE &kp F5    &kp F6    &kp F7    &kp F8                                  &kp F17   &kp F18   &kp F19   &kp F20   &none     &none
    &kp CLCK  &kp VOLD   &kp F9    &kp F10   &kp F11   &kp F12                                 &kp F21   &kp F22   &kp F23   &kp F24   &none     &none
                         &none     &none    &kp C_PREV &kp C_PP &kp C_NEXT         &kp C_BRI_UP &kp C_BRI_DN               &none
            >;

        };

        mouse_layer {
            label = "MOUSE";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |   TAB   |         |         |         |         |         |                              |         |         | SCRL UP |         |         |         |
// |   ESC   |  SELALL |   SAVE  |         |   FIND  |         |                              |  PGUP   | LCLICK  | MCLICK  | RCLICK  |         |         |
// |  SHIFT  |   CTRL  |   UNDO  |   CUT   |   COPY  |  PASTE  |                              |  PGDN   | SCRL LT | SCRL DN | SCRL RT |         |         |
//                     |   GUI   |   ALT   |   BSPC  |   DEL   | RETURN  |            |       |         |                   |         |

            bindings = <
    &trans    &none     &none     &none     &none     &none                                   &none        &none          &msc SCRL_UP   &none           &none   &none
    &trans    &kp LC(A) &kp LC(S) &none     &kp LC(F) &none                                   &kp PG_UP    &mkp LCLK      &mkp MCLK      &mkp RCLK       &none      &none
    &kt LSHIFT &kt LCTRL &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V)                               &kp PG_DN    &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &none      &none
                         &kt LGUI  &kt LALT  &kp BSPC  &trans  &trans              &none  &none                                               &none
            >;
        };

        bluetooth_layer {
            label = "BLUE";
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |         |         |         |        |        |         |                              |   BT1   |   BT2   |   BT3   |   BT4   |   BT5   |         |
// |         |    @    |   _     |  $     |   #    |   \     |                              |         |         |         |         |         |  BOOT   |
// |         |         |         |        | BOOT   |  RST    |                              |         |         |         |         |         |  RST    |
//                     |         |        |        |         |        |             |       |         |                   |         |
            bindings = <
    &none    &none     &none     &none    &none     &none                                   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
    &none    &kp AT_SIGN &kp UNDERSCORE &kp DOLLAR &kp HASH &kp BACKSLASH                   &bt BT_CLR        &none        &none        &none        &none        &bootloader
    &none    &none     &none   &none   &bootloader &sys_reset                               &none        &none        &none        &none        &none        &sys_reset
                       &none      &none    &none    &none     &none                 &bt BT_CLR_ALL        &none                        &none
            >;
        };

    };
};  